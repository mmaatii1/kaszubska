# Blokada plików, których nie wolno serwować publicznie
# (klucze API, kopie zapasowe, pliki robocze).
<FilesMatch "(^kontakt\.config.*\.php$|\.(bak|old|orig|save|swp|tmp|log|ini|sql|csv|md|gs|yml|yaml|py|mjs)$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Jedna wersja domeny: www.kaszubskaosada.com.pl → https://kaszubskaosada.com.pl (301).
# Ścieżka i parametry (np. gclid, utm_*) przechodzą bez zmian.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(kaszubskaosada\.com\.pl)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Fonty WOFF2 (assets/fonts) – poprawny typ MIME także na starszych serwerach.
AddType font/woff2 .woff2

# Cache przeglądarki. Pliki nie mają wersji w nazwie, więc bez „immutable”:
# zdjęcia/fonty 30 dni, PDF 1 dzień, HTML zawsze sprawdzany (nowe wdrożenie widać od razu).
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Kompresja tekstu (HTML ~200 KB -> ~40 KB).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>
