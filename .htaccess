# Blokada plików, których nie wolno serwować publicznie
# (klucze API, kopie zapasowe, pliki robocze).
<FilesMatch "(^kontakt\.config.*\.php$|\.(bak|old|orig|save|swp|tmp|log|ini|sql|md|gs|yml|yaml)$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Jedna wersja domeny: www.kaszubskaosada.com.pl → https://kaszubskaosada.com.pl (301).
# Ścieżka i parametry (np. gclid, utm_*) przechodzą bez zmian.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(kaszubskaosada\.com\.pl)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
